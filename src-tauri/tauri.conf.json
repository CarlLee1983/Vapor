{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapor",
  "version": "0.8.0",
  "identifier": "com.vapor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vapor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Carl Lee",
    "copyright": "Copyright © 2026 Carl Lee. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight Git workbench",
    "longDescription": "Vapor is a lightweight desktop Git workbench built with Tauri. It wraps the system git executable through a narrow Rust command layer, offering repository overview, commit history, diff viewing, working-tree status, and guided push / pull / remote management with a low memory footprint.",
    "homepage": "https://github.com/CarlLee1983/Vapor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
